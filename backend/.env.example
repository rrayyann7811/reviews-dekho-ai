# Reference only: FastAPI does NOT automatically load this file.
# Export reviewed values in the backend terminal; see docs/LOCAL_GUIDE.md.
AUTH_MODE=local
SENTIMENT_ENGINE=auto
AI_SUMMARIES=off
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
# Set DATABASE_URL explicitly to your NEW rehearsal database, for example:
# DATABASE_URL=sqlite:////absolute/path/to/new-rehearsal/reviews.db
# Never point testing at storage/reviews_dekho.db or storage/demo.db.
# MODEL_DIR defaults to backend/models/twitter-roberta-sentiment.
# No Supabase keys, paid API keys or Ollama are required for local mode.
