# Reference only: FastAPI does NOT automatically load this file.
# Export reviewed values in the backend terminal; see docs/LOCAL_GUIDE.md.
AUTH_MODE=local
SENTIMENT_ENGINE=auto
AI_SUMMARIES=off
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
# Set DATABASE_URL explicitly to your NEW rehearsal database, for example:
# DATABASE_URL=sqlite:////absolute/path/to/new-rehearsal/reviews.db
# Never point testing at storage/reviews_dekho.db or storage/demo.db.
# MODEL_DIR defaults to backend/models/twitter-roberta-sentiment.
# No Supabase keys, paid API keys or Ollama are required for local mode.

# Hosted showcase only. Set these together in the hosted environment.
# PUBLIC_DEMO=true
# REQUIRE_TRANSFORMER=true
# SENTIMENT_ENGINE=transformer
# AUTH_MODE=jwt
# AUTH_ISSUER=https://your-project.supabase.co/auth/v1
# AUTH_AUDIENCE=authenticated
# AUTH_ALGORITHM=ES256
# AUTH_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# CORS_ORIGINS=https://your-frontend.example
# DATABASE_URL must be supplied as a private server-side PostgreSQL secret.
# MAX_ROWS=10
# MAX_REVIEW_CHARS=1000
# MAX_UPLOAD_BYTES=1048576
# MAX_REQUEST_BYTES=1310720
# MAX_EXPENSIVE_REQUESTS=1
# RATE_LIMIT_ENABLED=true
# AI_SUMMARIES=off
# Match the parser bounds used in Phase 3E.1.
# MAX_COLUMNS=16
# MAX_XLSX_EXPANDED_BYTES=8388608
# MAX_XLSX_ENTRY_BYTES=4194304
# MAX_XLSX_ENTRIES=96
# DB_POOL_MODE=null
# VERCEL_SUPPORT_LARGE_FUNCTIONS=1  # Existing eligible Vercel projects only.
# Keep DB credentials and other private values on the backend project.
