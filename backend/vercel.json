{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "fluid": true,
  "regions": ["bom1"],
  "buildCommand": "MODEL_DIR=models/twitter-roberta-sentiment python scripts/download_model.py",
  "functions": {
    "server.py": {
      "maxDuration": 35,
      "includeFiles": "{app/**,alembic/**,alembic.ini,models/twitter-roberta-sentiment/**}",
      "excludeFiles": "{tests/**,data/**,storage/**,scripts/**,.venv/**,.pytest_cache/**,.env*,**/*.db,**/*.sqlite,**/*.sqlite3}"
    }
  }
}
