# Base URL of the FastAPI backend (no trailing slash)
VITE_API_URL=http://localhost:8000/api
# local preserves the existing local app; hosted gates private views behind a configured session adapter.
# No production project is connected. Never put private/service-role keys in VITE_* variables.
VITE_AUTH_MODE=local
# Later, in hosted mode only: HTTPS project URL and modern public sb_publishable_ key.
# Leave these empty for this offline checkpoint. No legacy JWT keys or sb_secret_ keys are accepted.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
